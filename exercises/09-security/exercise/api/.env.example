# Copy to .env. Never commit .env. The admin passwords must match the .env at the root of the repository.
# Outside the dev container use localhost; inside it the hosts are postgres, mongo and redis.

# PostgreSQL. The three roles are created by ../roles.sql, which reads these passwords
# from the environment (EX09_MIGRATIONS_PASSWORD, EX09_APP_PASSWORD, EX09_READONLY_PASSWORD).
EX09_MIGRATIONS_PASSWORD=change-me-ex09-migrations
EX09_APP_PASSWORD=change-me-ex09-app
EX09_READONLY_PASSWORD=change-me-ex09-readonly
# What the application uses: ex09_app, never postgres.
DATABASE_URL=postgresql://ex09_app:change-me-ex09-app@localhost:5432/ex09

# MongoDB root: used only by scripts/setup_mongo.py to create the application user.
MONGO_ADMIN_URL=mongodb://root:change-me-mongo@localhost:27017/?authSource=admin
MONGO_DB=ex09
MONGO_APP_USER=ex09_app
MONGO_APP_PASSWORD=change-me-ex09-mongo-app
MONGO_URL=mongodb://ex09_app:change-me-ex09-mongo-app@localhost:27017/ex09?authSource=ex09

# Redis default user: used only by scripts/setup_redis.py to create the ACL user.
REDIS_ADMIN_URL=redis://:change-me-redis@localhost:6379/9
REDIS_APP_USER=ex09_app
REDIS_APP_PASSWORD=change-me-ex09-redis-app
REDIS_URL=redis://ex09_app:change-me-ex09-redis-app@localhost:6379/9
