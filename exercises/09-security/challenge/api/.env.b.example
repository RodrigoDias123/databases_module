# Instance B (port 8002): the read-only users. Same variables as .env.a, other users.
# Copy to .env.b. Never commit it. Outside the dev container use localhost; inside it postgres, mongo and redis.
DATABASE_URL=postgresql://ex09_readonly:change-me-ex09-readonly@localhost:5432/ex09
MONGO_URL=mongodb://ex09_reader:change-me-ex09-mongo-reader@localhost:27017/ex09?authSource=ex09
MONGO_DB=ex09
REDIS_URL=redis://ex09_reader:change-me-ex09-redis-reader@localhost:6379/9
