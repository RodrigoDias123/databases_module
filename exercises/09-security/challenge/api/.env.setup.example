# Only for scripts/setup_mongo.py and scripts/setup_redis.py: the admin accounts and the passwords
# of the users they create. Neither instance reads this file.
# Copy to .env.setup. Never commit it. The admin passwords must match the .env at the root of the repository.
MONGO_ADMIN_URL=mongodb://root:change-me-mongo@localhost:27017/?authSource=admin
MONGO_DB=ex09
MONGO_APP_PASSWORD=change-me-ex09-mongo-app
MONGO_READER_PASSWORD=change-me-ex09-mongo-reader

REDIS_ADMIN_URL=redis://:change-me-redis@localhost:6379/9
REDIS_APP_PASSWORD=change-me-ex09-redis-app
REDIS_READER_PASSWORD=change-me-ex09-redis-reader
